# Host-specific guards for build.sh. Copy to local.env (gitignored, sourced if present) and edit.
# All values are optional; the defaults are empty, which disables the guard.
# Plain shell assignments; the file is sourced by build.sh.

# systemd units (system scope, whitespace-separated) that must be inactive when a build starts,
# e.g. a service that uses the GPU or holds a capture device.
PRECHECK_UNITS="example-service.service"

# Extended regex for `pgrep -af`: a build does not start while a matching process is running,
# e.g. benchmark or test runs that the compile load would disturb.
PRECHECK_PGREP='my-benchmark|my-test-runner'

# Directories (whitespace-separated) the build must not run in or below: the current directory,
# the repository directory and $BUILD are all checked.
FORBIDDEN_DIRS="$HOME/src/some-project $HOME/src/some-project-worktrees"

# Glob; a build venv ($BV) whose directory name matches it is refused, so the build requirements
# are never installed into a project venv.
FORBIDDEN_BV_GLOB='some-project*'
