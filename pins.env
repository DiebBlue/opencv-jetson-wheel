# Pinned build inputs. Sourced by build.sh; plain KEY=VALUE only.
# Changing any value is a release change: follow the update table in README.md.

# opencv-python tag 93 = PyPI opencv-python(-headless) 5.0.0.93
OPENCV_PYTHON_REPO=https://github.com/opencv/opencv-python.git
OPENCV_PYTHON_TAG=93
OPENCV_PYTHON_SHA=b83046cda41133f1bf2e73e99dba16a1248f103a
# submodules recorded by that tag (opencv tag 5.0.0, opencv_contrib tag 5.0.0)
OPENCV_SHA=40738fb16ceddb5fb3fea747585f7ce6abb0605b
OPENCV_CONTRIB_SHA=755e50675d97db9b7d449d8bd6b09888646f6c6e

# local version label: <cuda major><minor>.l4t<major>.<build counter>
LOCAL_LABEL=cu126.l4t36.1

# Orin GPU compute capability; no PTX (CUDA_ARCH_PTX is empty in cmake-flags.txt)
CUDA_ARCH_BIN=8.7
# contrib modules compiled in addition to the opencv-python headless set
CUDA_MODULES="cudev cudaarithm cudafilters cudaimgproc cudawarping cudafeatures2d"
# targets built by the pilot (same modules, CMake target names)
PILOT_TARGETS="opencv_cudev opencv_cudaarithm opencv_cudawarping opencv_cudaimgproc opencv_cudafilters opencv_cudafeatures2d"
